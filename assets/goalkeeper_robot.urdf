<?xml version="1.0"?>
<robot name="goalkeeper_robot">
  <material name="rail_gray">
    <color rgba="0.32 0.36 0.42 1"/>
  </material>
  <material name="motor_blue">
    <color rgba="0.08 0.32 0.86 1"/>
  </material>
  <material name="paddle_yellow">
    <color rgba="0.96 0.68 0.08 1"/>
  </material>
  <material name="warning_black">
    <color rgba="0.05 0.07 0.09 1"/>
  </material>

  <link name="rail_base">
    <visual>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.14 5.2 0.10"/></geometry>
      <material name="rail_gray"/>
    </visual>
    <visual>
      <origin xyz="0 -2.55 0.30"/>
      <geometry><box size="0.28 0.18 0.60"/></geometry>
      <material name="rail_gray"/>
    </visual>
    <visual>
      <origin xyz="0 2.55 0.30"/>
      <geometry><box size="0.28 0.18 0.60"/></geometry>
      <material name="rail_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.14 5.2 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07"/>
      <mass value="15.0"/>
      <inertia ixx="33.8" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="33.8"/>
    </inertial>
  </link>

  <link name="goalkeeper_carriage">
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry><box size="0.34 0.42 0.28"/></geometry>
      <material name="motor_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.11 0 0.43"/>
      <geometry><box size="0.13 0.52 0.58"/></geometry>
      <material name="paddle_yellow"/>
    </visual>
    <visual>
      <origin xyz="-0.18 0 0.43"/>
      <geometry><box size="0.025 0.39 0.40"/></geometry>
      <material name="warning_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.20"/>
      <geometry><box size="0.34 0.42 0.28"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.11 0 0.43"/>
      <geometry><box size="0.13 0.52 0.58"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.26"/>
      <mass value="4.0"/>
      <inertia ixx="0.20" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.20"/>
    </inertial>
  </link>

  <joint name="goalkeeper_slide" type="prismatic">
    <parent link="rail_base"/>
    <child link="goalkeeper_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.35" upper="2.35" effort="800" velocity="2.5"/>
    <dynamics damping="2.0" friction="0.1"/>
  </joint>
</robot>
