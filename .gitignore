# Python environments and build products
.venv/
.venv-gpu/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test, lint, coverage, and simulator caches
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.coverage
htmlcov/
.cache/
tmp/

# Generated experiment outputs
output/
recordings/
outputs/
*.log

# Keep only the reviewed model and final demonstration video
artifacts/*
!artifacts/goalkeeper_model.pt
!artifacts/goalkeeper_model.json
videos/*
!videos/PAI_final_goalkeeper.mp4

# Large generated model/media formats are excluded by default
*.pth
*.ckpt
*.onnx
*.safetensors
*.avi
*.mov

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Course handouts and local notes are not public deliverables
*最終課題*.pdf
worklogs/
